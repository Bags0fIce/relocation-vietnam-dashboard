# Generate a unique 32-byte hex secret on the VPS (for example: openssl rand -hex 32).
# Do not commit the populated .env file or send secrets in chat.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
APP_ORIGIN=https://dashboard.example.com
SESSION_DAYS=7
BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_ONE_TIME_SETUP_TOKEN

# Invitations and password reset cannot be enabled until an approved sender is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Relocation Vietnam <dashboard@example.com>
